# planary-tournament (the app): copy to .env.local for development. No secrets here; the app only
# holds the signed-in person's Planary token in the browser.

# The Tournament API (api/ in this repo)
NEXT_PUBLIC_TOURNAMENT_API=https://tournament-api.planary.ch
# Planary Account (sign-in). AUTH_API_URL is the server-side hop for /api/me.
NEXT_PUBLIC_AUTH_BASE_URL=https://auth.planary.ch
AUTH_API_URL=https://auth.planary.ch
NEXT_PUBLIC_APP_URL=https://tournament.planary.ch
NEXT_PUBLIC_PORTAL_URL=https://portal.planary.ch
